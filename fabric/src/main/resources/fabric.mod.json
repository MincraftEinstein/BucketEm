        "modmenu.modrinth": "https://modrinth.com/user/Qzimyion",
        "modmenu.youtube": "https://www.youtube.com/channel/UCSuyyyXWzsShu0Q41__b2Pw",
        "GitHub": "https://github.com/Qzimyion",
        "Tumblr": "https://qzimyion.tumblr.com/"
      }
    }
  }
}
