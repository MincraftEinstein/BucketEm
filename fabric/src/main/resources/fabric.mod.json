{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "https://modrinth.com/user/Qzimyion",
    "issues": "https://github.com/Qzimyion/BucketEm/issues",
    "sources": "https://github.com/Qzimyion/BucketEm"
  },
  "license": "${mod_license}",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.qzimyion.bucketem.fabric.BucketemFabric"
    ],
    "client": [
      "com.qzimyion.bucketem.fabric.client.BucketemFabricClient"
    ],
    "fabric-datagen": [
      "com.qzimyion.bucketem.fabric.BucketemDataGenerator"
    ]
  },
  "mixins": [
    "bucketem.mixins.json", "bucketemfabric.mixins.json"
  ],
  "accessWidener": "bucketem.accesswidener",
  "depends": {
    "fabricloader": ">=0.16.10",
    "minecraft": "~${minecraft_version}",
    "java": ">=17",
    "architectury": ">=${architectury_api_version}",
